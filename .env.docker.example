# Copy to .env.docker and fill in. Compose reads this file for every app
# service. Do not commit .env.docker.
#
#   cp .env.docker.example .env.docker
#   docker run --rm econnectsports:latest bin/rails secret   # for SECRET_KEY_BASE

RAILS_ENV=production
SECRET_KEY_BASE=

# The app talks to the compose services by name.
DATABASE_HOST=postgres
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=idigitallsports_production
REDIS_URL=redis://redis:6379/

# Puma serves the precompiled assets itself; with a reverse proxy in front you
# would normally let the proxy do it and drop this.
RAILS_SERVE_STATIC_FILES=1
RAILS_LOG_TO_STDOUT=1
RAILS_LOG_LEVEL=info
RAILS_MAX_THREADS=5

# force_ssl is on by default. Turn both off to reach the container over plain
# HTTP (local testing, or a proxy that does not set X-Forwarded-Proto).
RAILS_FORCE_SSL=false
RAILS_ASSUME_SSL=false

# Outbound mail
SMTP_ADDRESS=smtp.sendgrid.net
SMTP_PORT=587
SMTP_DOMAIN=www.idigitallsports.com
SMTP_USER_NAME=
SMTP_PASSWORD=

# CarrierWave uploads to S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Card payments
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Newsletter signup
AWEBER_CONSUMER_KEY=
AWEBER_CONSUMER_SECRET=
AWEBER_ACCESS_TOKEN=
AWEBER_ACCESS_TOKEN_SECRET=
AWEBER_LIST_ID=
