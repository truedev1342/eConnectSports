<h2 class="reset-password">Change your password</h2>

<%= form_with(model: resource, url: password_path(resource_name), as: resource_name, html: { method: :put }, local: true) do |f| %>
  <%= devise_error_messages! %>
  <%= f.hidden_field :reset_password_token %>

  <div class="reset-password"><%= f.label :password, "New password" %><br />
  <%= f.password_field :password %></div>

  <div class="reset-password"><%= f.label :password_confirmation, "Confirm new password" %><br />
  <%= f.password_field :password_confirmation %></div>

  <div><%= f.submit "Change my password", class: 'reset-password' %></div>
<% end %>

<%= render "devise/shared/links" %>
