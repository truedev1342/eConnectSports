<div class="container">
  <div class="error-page">
    <h1>404 - Page Not Found</h1>
    <p>Sorry, the page you are looking for does not exist.</p>
    <div class="actions">
      <%= link_to 'Go to Homepage', root_path, class: 'btn btn-primary' %>
    </div>
  </div>
</div>

<style>
  .error-page {
    text-align: center;
    margin-top: 50px;
  }
  .error-page h1 {
    color: #dc3545;
    font-size: 48px;
  }
  .error-page p {
    font-size: 18px;
    margin-bottom: 20px;
  }
</style>
