#!/bin/bash
set -e

# Puma leaves a pidfile behind if the container was killed rather than stopped.
rm -f tmp/pids/server.pid

# Only the web process prepares the database; the workers just wait for it.
if [ "${DB_PREPARE:-false}" = "true" ]; then
  echo "==> Waiting for PostgreSQL at ${DATABASE_HOST:-localhost}"
  until bundle exec rails runner 'ActiveRecord::Base.connection_pool.with_connection { |c| c.execute("SELECT 1") }' >/dev/null 2>&1; do
    sleep 2
  done

  echo "==> Preparing the database"
  bundle exec rails db:prepare
fi

exec "$@"
